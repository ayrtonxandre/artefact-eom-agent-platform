# =============================================================================
# Artefact End-of-Mission (EOM) Agent Platform - Environment Configuration
# Copy this file to .env and adjust values as needed.
# =============================================================================

# Google Cloud Vertex AI Configuration
GOOGLE_CLOUD_PROJECT=privategpt-437907
GOOGLE_CLOUD_LOCATION=europe-west1
GOOGLE_GENAI_USE_ENTERPRISE=true

# Local Credential File Paths (relative to repository root or absolute)
GOOGLE_APPLICATION_CREDENTIALS=service_account.json
DRIVE_TOKEN_PATH=drive_token.json

# (Optional) In-memory OAuth Token JSON (primarily used in Cloud Run deployments)
# DRIVE_TOKEN_JSON={"token": "...", "refresh_token": "...", "client_id": "...", "client_secret": "..."}

# BigQuery Settings (Defaults to Global Finance Dashboard)
BQ_PROJECT_ID=global-finance-dashboard
BQ_DATASET_ID=finance_dataset
BQ_MISSIONS_TABLE=global-finance-dashboard.finance_dataset.eom_missions_tracking
MOCK_BQ=false

# Central Status Tracker Google Spreadsheet ID
# Default: Official Artefact EOM Central Pipeline Tracker
CENTRAL_TRACKER_ID=1IDMXRrgiONxaxqB1N-ahRMoiHx4tqfB9vxhSxyhnH7s

# Local FastAPI Server Port (Defaults to 8080)
PORT=8080
